# ------------------------------------------------------------
# Tori (envios-pe) — local environment
# Copy to .env.local and fill in the values:
#   cp .env.local.sample .env.local        (macOS / Linux / Git Bash)
#   Copy-Item .env.local.sample .env.local  (PowerShell)
# Never commit .env.local.
# ------------------------------------------------------------

# --- Supabase (REQUIRED) ------------------------------------
# Supabase dashboard → Project Settings → API
# ALL THREE ARE SERVER-ONLY. The browser never talks to the database: every read
# and write goes through /api routes, so nothing here is prefixed NEXT_PUBLIC_
# and none of it reaches the JavaScript bundle (e2e/no-leaks.spec.ts checks it).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Bypasses RLS — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (Old NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY still work as a
# fallback for existing deployments; delete them from the hosting once
# SUPABASE_URL / SUPABASE_ANON_KEY are set.)

# --- Site URL (recommended) ---------------------------------
# Used for metadata, payment return URLs and admin impersonation links.
# Falls back to https://tori.pe in app/layout.tsx if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MercadoPago (optional: subscriptions / payments) -------
# https://www.mercadopago.com.pe/developers/panel → your app → credentials.
# Use TEST credentials locally.
MP_ACCESS_TOKEN=
# Webhook signature secret (Webhooks → secret key). REQUIRED: without it
# /api/webhooks/mercadopago rejects every notification.
MP_WEBHOOK_SECRET=

# --- Cron ----------------------------------------------------
# REQUIRED in production. Vercel sends it as `Authorization: Bearer <value>`
# to the routes in vercel.json; without it the cron routes return 401.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Courier agency sync (optional) -------------------------
# Shared secrets for manual POST /api/olva/sync and /api/shalom/sync
# (sent as the x-sync-key header). Any long random string works.
OLVA_SYNC_SECRET=
SHALOM_SYNC_SECRET=

# --- Analytics (optional) -----------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
